<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    xmlns:models="using:Switchman.Core.Models"
    xmlns:vm="using:Switchman.Core.ViewModels"
    x:DefaultBindMode="OneWay">
    <Grid Padding="36,24,36,36" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Reglas"/>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Cada regla envía los enlaces de un dominio (y opcionalmente una ruta) a un navegador o webapp."/>
            <InfoBar Margin="0,16,0,0" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}"
                 Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}"
                 Message="{x:Bind ViewModel.Message}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4">
                <ListView ItemsSource="{x:Bind ViewModel.Rules}" SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleItem">
                            <StackPanel Padding="0,8">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind BrowserName}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16"
                    Visibility="{x:Bind ViewModel.HasSelection}">
                <StackPanel Spacing="16">
                    <TextBox Header="Dominio o ruta (p. ej. github.com o github.com/miorg)"
                             Text="{x:Bind ViewModel.SelectedRule.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Header="Navegador o webapp" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Browsers}" SelectedValuePath="Id"
                              SelectedValue="{x:Bind ViewModel.SelectedRule.BrowserId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Browser">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ToggleSwitch Header="Quitar parámetros de rastreo"
                                 IsOn="{x:Bind ViewModel.SelectedRule.StripTracking, Mode=TwoWay}"/>

                    <Button Content="Quitar regla" Command="{x:Bind ViewModel.RemoveRuleCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedRule}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Agregar regla" Command="{x:Bind ViewModel.AddRuleCommand}"/>
            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}"/>
        </StackPanel>
    </Grid>
</Page>
