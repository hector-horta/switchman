<Page x:Class="Switchman.App.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:Switchman.Core.Resources"
      xmlns:app="using:Switchman.App"
      xmlns:vm="using:Switchman.Core.ViewModels"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      x:DefaultBindMode="OneWay">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind res:Strings.NavApps, Mode=OneTime}" />
            <TextBlock Margin="0,0,0,16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="{x:Bind res:Strings.AppsIntro, Mode=OneTime}" />

            <InfoBar Margin="0,0,0,8" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}"
                     IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}"
                     Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}"
                     Message="{x:Bind ViewModel.Message}" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{x:Bind res:Strings.AppsDetected, Mode=OneTime}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Bind res:Strings.AppsScan, Mode=OneTime}" Command="{x:Bind ViewModel.LoadCommand}" />
                    <Button Content="{x:Bind res:Strings.Save, Mode=OneTime}" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppToggle">
                        <controls:SettingsCard Header="{x:Bind Name, Mode=OneTime}"
                                             Description="{x:Bind Domains, Mode=OneTime}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch OnContent="{x:Bind res:Strings.ToggleOn, Mode=OneTime}" OffContent="{x:Bind res:Strings.ToggleOff, Mode=OneTime}" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind ViewModel.NotInstalled}" />

            <TextBlock Margin="0,32,0,4" Style="{StaticResource SubtitleTextBlockStyle}"
                      Text="{x:Bind res:Strings.AppsCustomTitle, Mode=OneTime}" />

            <TextBlock Margin="0,0,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="{x:Bind res:Strings.DlIntro, Mode=OneTime}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4" MinHeight="160">
                    <ListView ItemsSource="{x:Bind ViewModel.CustomLinks}"
                              SelectedItem="{x:Bind ViewModel.SelectedLink, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeepLinkItem">
                                <StackPanel Padding="0,6">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Scheme}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16" VerticalAlignment="Top"
                        Visibility="{x:Bind ViewModel.HasSelection}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <ComboBox Header="{x:Bind res:Strings.DlApp, Mode=OneTime}" PlaceholderText="{x:Bind res:Strings.DlAppPlaceholder, Mode=OneTime}"
                                      IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.OtherSchemes}"
                                      Text="{x:Bind ViewModel.Editor.Link.Scheme, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Editor.SchemeError}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.SchemeError)}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind res:Strings.AppsName, Mode=OneTime}" Text="{x:Bind ViewModel.Editor.Link.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Editor.NameError}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.NameError)}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind res:Strings.AppsDomains, Mode=OneTime}" AcceptsReturn="True" MinHeight="72"
                                     Text="{x:Bind ViewModel.Editor.Link.DomainsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Editor.DomainsError}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.DomainsError)}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind res:Strings.AppsTemplate, Mode=OneTime}" Text="{x:Bind ViewModel.Editor.Link.Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel>
                                <HyperlinkButton Content="{x:Bind res:Strings.DlPresetWhole, Mode=OneTime}" Command="{x:Bind ViewModel.Editor.UseWholeLinkCommand}" />
                                <HyperlinkButton Content="{x:Bind res:Strings.DlPresetReplace, Mode=OneTime}" Command="{x:Bind ViewModel.Editor.UseReplaceSchemeCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind res:Strings.DlTemplateHelp, Mode=OneTime}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Editor.TemplateError}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.TemplateError)}" />
                        </StackPanel>
                        <Border Height="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind res:Strings.DlExample, Mode=OneTime}" Text="{x:Bind ViewModel.Editor.ExampleUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind res:Strings.DlOpensAs, Mode=OneTime}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.PreviewUri)}" />
                            <TextBlock FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="{x:Bind ViewModel.Editor.PreviewUri}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Editor.PreviewNote}" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.PreviewNote)}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind res:Strings.DlTry, Mode=OneTime}" Command="{x:Bind ViewModel.Editor.TryCommand}" />
                            <Button Content="{x:Bind res:Strings.AppsRemoveLink, Mode=OneTime}" Command="{x:Bind ViewModel.RemoveLinkCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedLink}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Margin="0,8,0,0" Content="{x:Bind res:Strings.AppsNewLink, Mode=OneTime}"
                    Command="{x:Bind ViewModel.AddLinkCommand}" />

        </StackPanel>
    </ScrollViewer>
</Page>
