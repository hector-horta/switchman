<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:Switchman.Core.Resources"
    xmlns:app="using:Switchman.App"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    x:DefaultBindMode="OneWay">
    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="4">
            <TextBlock Margin="0,0,0,20" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind res:Strings.NavSettings, Mode=OneTime}" />
            <InfoBar Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}" Margin="0,0,0,8" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}" Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}" Message="{x:Bind ViewModel.Message}" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind res:Strings.SettingsTrackingTitle, Mode=OneTime}" />

            <controls:SettingsCard Header="{x:Bind res:Strings.StripTracking, Mode=OneTime}"
                                 Description="{x:Bind res:Strings.SettingsStripDescription, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="{x:Bind res:Strings.ToggleOn, Mode=OneTime}" OffContent="{x:Bind res:Strings.ToggleOff, Mode=OneTime}" IsOn="{x:Bind ViewModel.StripTracking, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsExpander Header="{x:Bind res:Strings.SettingsExtra, Mode=OneTime}"
                                      Description="{x:Bind res:Strings.SettingsExtraDescription, Mode=OneTime}"
                                      IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE710;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                                 PlaceholderText="ref&#x0a;mc_cid" Text="{x:Bind ViewModel.ExtraParams, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <Button Margin="0,12,0,0" Content="{x:Bind res:Strings.Save, Mode=OneTime}"
                   Style="{StaticResource AccentButtonStyle}"
                   Command="{x:Bind ViewModel.SaveCommand}" />

            <TextBlock Margin="0,32,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind res:Strings.SettingsDefaultTitle, Mode=OneTime}" />

            <controls:SettingsCard Header="{x:Bind res:Strings.SettingsDefaultCard, Mode=OneTime}"
                                 Description="{x:Bind app:Ui.DefaultState(ViewModel.IsDefault)}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="{x:Bind res:Strings.SettingsRegister, Mode=OneTime}" Command="{x:Bind ViewModel.RegisterCommand}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Bind res:Strings.SettingsRegistryCard, Mode=OneTime}"
                                 Description="{x:Bind app:Ui.RegisteredAt(ViewModel.Status)}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="{x:Bind res:Strings.SettingsUnregister, Mode=OneTime}" Command="{x:Bind ViewModel.UnregisterCommand}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
