<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    x:DefaultBindMode="OneWay">
    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="4">
            <TextBlock Margin="0,0,0,20" Style="{StaticResource TitleTextBlockStyle}" Text="Ajustes" />
            <InfoBar Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}" Margin="0,0,0,8" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}" Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}" Message="{x:Bind ViewModel.Message}" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="Limpieza de rastreo" />

            <controls:SettingsCard Header="Quitar parámetros de rastreo"
                                 Description="utm_*, fbclid, gclid, si y otros identificadores de campañas y redes sociales.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StripTracking, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsExpander Header="Parámetros extra a quitar"
                                      Description="Uno por línea. Se suman a la lista de fábrica."
                                      IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE710;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                                 PlaceholderText="ref&#x0a;mc_cid" Text="{x:Bind ViewModel.ExtraParams, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <Button Margin="0,12,0,0" Content="Guardar"
                   Style="{StaticResource AccentButtonStyle}"
                   Command="{x:Bind ViewModel.SaveCommand}" />

            <TextBlock Margin="0,32,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="Navegador predeterminado de Windows" />

            <controls:SettingsCard Header="Navegador predeterminado"
                                 Description="{x:Bind app:Ui.DefaultState(ViewModel.IsDefault)}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Registrar como predeterminado" Command="{x:Bind ViewModel.RegisterCommand}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Registro en Windows"
                                 Description="{x:Bind app:Ui.RegisteredAt(ViewModel.Status)}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Quitar registro" Command="{x:Bind ViewModel.UnregisterCommand}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
