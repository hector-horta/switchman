<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.TestLinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24,16,24,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Probar enlace" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="Muestra qué navegador abriría el enlace y cómo queda sin parámetros de rastreo. No abre nada." />

        <TextBox Header="Enlace" PlaceholderText="https://ejemplo.com/?utm_source=..."
                 Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Button Content="Probar" Style="{StaticResource AccentButtonStyle}"
               Command="{x:Bind ViewModel.TestCommand}" />

        <InfoBar IsClosable="False" Severity="Error"
                 IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message), Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}"/>

        <StackPanel Spacing="4" Visibility="{x:Bind app:Ui.VisibleIfSet(ViewModel.Result), Mode=OneWay}">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Navegador" />
            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Result.BrowserName, Mode=OneWay}" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Regla aplicada" Margin="0,8,0,0" />
            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind app:Ui.RuleText(ViewModel.Result), Mode=OneWay}" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Enlace limpio" Margin="0,8,0,0" />
            <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="{x:Bind ViewModel.Result.Url, Mode=OneWay}" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Se quitaron parámetros" Margin="0,8,0,0" />
            <TextBlock Text="{x:Bind app:Ui.YesNo(ViewModel.Result.Stripped), Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</Page>
