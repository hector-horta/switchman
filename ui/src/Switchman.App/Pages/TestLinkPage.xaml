<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.TestLinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    x:DefaultBindMode="OneWay">
    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Probar enlace" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Muestra qué navegador abriría el enlace y cómo queda sin parámetros de rastreo. No abre nada." />
            </StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Enlace"
                         PlaceholderText="https://ejemplo.com/?utm_source=..."
                         Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Content="Probar"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TestCommand}" />
            </Grid>
            <InfoBar Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}"
                     Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}"
                     Message="{x:Bind ViewModel.Message}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="16"
                    Visibility="{x:Bind app:Ui.VisibleIfSet(ViewModel.Result)}">
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Navegador" />
                    <TextBlock Grid.Column="1" Grid.Row="0" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Text="{x:Bind ViewModel.Result.BrowserName}" />

                    <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Regla aplicada" />
                    <TextBlock Grid.Column="1" Grid.Row="1" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Text="{x:Bind app:Ui.RuleText(ViewModel.Result)}" />

                    <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Enlace limpio" />
                    <TextBlock Grid.Column="1" Grid.Row="2" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Text="{x:Bind ViewModel.Result.Url}" />

                    <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Se quitaron parámetros" />
                    <TextBlock Grid.Column="1" Grid.Row="3" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Text="{x:Bind app:Ui.YesNo(ViewModel.Result.Stripped)}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
