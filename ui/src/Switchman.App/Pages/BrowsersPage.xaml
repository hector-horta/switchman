<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.BrowsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    xmlns:models="using:Switchman.Core.Models"
    x:DefaultBindMode="OneWay">
    <Grid Padding="36,24,36,36" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Navegadores"/>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="El navegador por defecto abre los enlaces sin regla. El de respaldo se usa si config.json falta o está dañado."/>
            <InfoBar Margin="0,16,0,0" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Message)}" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message)}"
                 Severity="{x:Bind app:Ui.SeverityOf(ViewModel.MessageKind)}" Message="{x:Bind ViewModel.Message}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Header="Navegador por defecto"
                          HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Browsers}"
                          SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.DefaultBrowserId, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Browser">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="1" Header="Navegador de respaldo"
                          HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Browsers}"
                          SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.FallbackBrowserId, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Browser">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Detectados"/>

            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4">
                <ListView ItemsSource="{x:Bind ViewModel.Browsers}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Browser">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"/>
                                <TextBlock Text="{x:Bind ExePath, Mode=OneTime}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Button Grid.Row="3" Content="Guardar"
                Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"/>
    </Grid>
</Page>
