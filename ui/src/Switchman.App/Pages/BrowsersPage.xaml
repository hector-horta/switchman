<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Switchman.App.Pages.BrowsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Switchman.App"
    xmlns:models="using:Switchman.Core.Models">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Navegadores"/>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="El navegador por defecto abre los enlaces sin regla. El de respaldo se usa si config.json falta o está dañado."/>
        </StackPanel>

        <InfoBar Grid.Row="1" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message), Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}"/>

        <!-- Grid y no StackPanel: así la lista de detectados usa el alto restante y se desplaza (ventana de tamaño fijo). -->
        <Grid Grid.Row="2" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ComboBox Grid.Row="0" Header="Navegador por defecto"
                      MinWidth="320"
                      ItemsSource="{x:Bind ViewModel.Browsers}"
                      SelectedValuePath="Id"
                      SelectedValue="{x:Bind ViewModel.DefaultBrowserId, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Browser">
                        <TextBlock Text="{x:Bind Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Grid.Row="1" Header="Navegador de respaldo"
                      MinWidth="320"
                      ItemsSource="{x:Bind ViewModel.Browsers}"
                      SelectedValuePath="Id"
                      SelectedValue="{x:Bind ViewModel.FallbackBrowserId, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Browser">
                        <TextBlock Text="{x:Bind Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Detectados"/>

            <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Browsers}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Browser">
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind ExePath}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Button Grid.Row="3" Content="Guardar"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SaveCommand}"/>
    </Grid>
</Page>
