<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FerroLink.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:FerroLink.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FerroLink.App.Pages"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <!-- Title -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Ajustes" />

            <!-- InfoBar -->
            <InfoBar IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

            <!-- Tracking Cleanup Section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Limpieza de rastreo" />
            <ToggleSwitch Header="Quitar parámetros de rastreo (utm_*, fbclid, gclid...)"
                          IsOn="{x:Bind ViewModel.StripTracking, Mode=TwoWay}" />

            <TextBox Header="Parámetros extra a quitar (uno por línea)" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="96"
                     Text="{x:Bind ViewModel.ExtraParams, Mode=TwoWay}"/>

            <!-- Save Button -->
            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}"
                   Command="{x:Bind ViewModel.SaveCommand}" />

            <!-- Default Browser Section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Navegador predeterminado de Windows" />
            <TextBlock TextWrapping="Wrap"
                       Text="{x:Bind app:Ui.DefaultState(ViewModel.IsDefault), Mode=OneWay}"/>

            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap" IsTextSelectionEnabled="True"
                      Text="{x:Bind app:Ui.RegisteredAt(ViewModel.Status), Mode=OneWay}" />

            <!-- Browser Registration Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Registrar como navegador"
                        Command="{x:Bind ViewModel.RegisterCommand}"/>
                <Button Content="Quitar registro"
                        Command="{x:Bind ViewModel.UnregisterCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
