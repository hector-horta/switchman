<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FerroLink.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:FerroLink.App"
    xmlns:models="using:FerroLink.Core.Models"
    xmlns:vm="using:FerroLink.Core.ViewModels">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Reglas" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Cada regla envía los enlaces de un dominio (y opcionalmente una ruta) a un navegador."/>
        </StackPanel>

        <InfoBar Grid.Row="1" IsClosable="False" IsOpen="{x:Bind app:Ui.HasText(ViewModel.Message), Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Rules}"
                      SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuleItem">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Pattern, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind BrowserId, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <TextBox Header="Dominio o ruta (p. ej. github.com o github.com/miorg)"
                         Text="{x:Bind ViewModel.SelectedRule.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Header="Navegador" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Browsers}" SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedRule.BrowserId, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Browser">
                            <TextBlock Text="{x:Bind Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ToggleSwitch Header="Quitar parámetros de rastreo"
                              IsOn="{x:Bind ViewModel.SelectedRule.StripTracking, Mode=TwoWay}"/>

                <Button Content="Quitar regla" Command="{x:Bind ViewModel.RemoveRuleCommand}"
                       CommandParameter="{x:Bind ViewModel.SelectedRule, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Agregar regla" Command="{x:Bind ViewModel.AddRuleCommand}" />
            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}"
                   Command="{x:Bind ViewModel.SaveCommand}"/>
        </StackPanel>
    </Grid>
</Page>
